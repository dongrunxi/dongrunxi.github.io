---
import { getPublishedPosts, formatDate } from '../lib/posts';
import BaseLayout from '../layouts/BaseLayout.astro';

const posts = await getPublishedPosts();
const byYear = new Map<number, typeof posts>();
for (const p of posts) {
  const y = new Intl.DateTimeFormat('en', { timeZone: 'Asia/Shanghai', year: 'numeric' }).format(p.data.date);
  const year = Number(y);
  if (!byYear.has(year)) byYear.set(year, []);
  byYear.get(year)!.push(p);
}
const years = [...byYear.keys()].sort((a, b) => b - a);
---

<BaseLayout title="归档" description="全部文章按年份归档">
  <h1 class="page-title">归档</h1>
  {posts.length === 0 && <p class="empty-hint">还没有文章。</p>}
  {years.map((year) => (
    <section>
      <h2 class="archive-year">{year}</h2>
      <ul class="archive-list">
        {byYear.get(year)!.map((p) => (
          <li>
            <span class="archive-date">{formatDate(p.data.date)}</span>
            <a href={`/posts/${p.id}/`}>{p.data.title}</a>
          </li>
        ))}
      </ul>
    </section>
  ))}
</BaseLayout>
